<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nuvio" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/nuvio_background</item>
    </style>

    <style name="Theme.Nuvio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nuvio_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>

    <style name="Theme.Nuvio.Splash.Gold" parent="@style/Theme.Nuvio.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_gold</item>
    </style>

    <style name="Theme.Nuvio.Splash.Emerald" parent="@style/Theme.Nuvio.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_emerald</item>
    </style>

    <style name="Theme.Nuvio.Splash.Ocean" parent="@style/Theme.Nuvio.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_ocean</item>
    </style>

    <style name="Theme.Nuvio.Splash.Royal" parent="@style/Theme.Nuvio.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_royal</item>
    </style>

    <style name="Theme.Nuvio.Splash.Sunset" parent="@style/Theme.Nuvio.Splash">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo_sunset</item>
    </style>

    <!-- Splash cold-start SINEMAQ (Android 12+): sistem tampilkan charcoal polos + icon kosong,
         animasi wordmark diputar SplashActivity. postSplashScreenTheme keturunan AppCompat. -->
    <style name="Theme.Sinemaq.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sinemaq_charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
    <style name="Theme.Sinemaq.Starting.Emerald" parent="@style/Theme.Sinemaq.Starting">
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
    <style name="Theme.Sinemaq.Starting.Gold" parent="@style/Theme.Sinemaq.Starting">
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
    <style name="Theme.Sinemaq.Starting.Ocean" parent="@style/Theme.Sinemaq.Starting">
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
    <style name="Theme.Sinemaq.Starting.Royal" parent="@style/Theme.Sinemaq.Starting">
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
    <style name="Theme.Sinemaq.Starting.Sunset" parent="@style/Theme.Sinemaq.Starting">
        <item name="postSplashScreenTheme">@style/Theme.Nuvio</item>
    </style>
</resources>
