# Copy to local.properties (gitignored) and fill in your own keys.
# Empty values leave the related integration cleanly disabled.

# Supabase
SINEMAQ_SUPABASE_URL=
SINEMAQ_SUPABASE_ANON_KEY=
SINEMAQ_SUPABASE_FALLBACK_URL=

# Sentry (SENTRY_ENVIRONMENT is auto-derived by Gradle per build type)
SENTRY_DSN=
# Optional: Sentry Gradle plugin mapping upload for release builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Metadata / API
TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=
SIMKL_CLIENT_ID=
SIMKL_REDIRECT_URI=
SIMKL_APP_NAME=
MDBLIST_CLIENT_ID=

# Membership upgrade landing page (opened by the profile-limit upgrade prompt)
UPGRADE_URL=
PREMIUMIZE_CLIENT_ID=
INTRODB_API_URL=
IMDB_RATINGS_API_BASE_URL=
IMDB_TAPFRAME_API_BASE_URL=

# Android release signing
SINEMAQ_RELEASE_STORE_FILE=
SINEMAQ_RELEASE_STORE_PASSWORD=
SINEMAQ_RELEASE_KEY_ALIAS=
SINEMAQ_RELEASE_KEY_PASSWORD=
